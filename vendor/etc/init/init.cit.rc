on property:sys.sarcali.trigger=1
    start sarcalisvc

service sarcalisvc /vendor/bin/sns_sensors_test_and_cal -c 57,3,50000000,0
    class main
    user root
    disabled
    oneshot
    group root system
    seclabel u:r:sardiag:s0

on property:sys.backlight.trigger=1
    start backlightsvc

service backlightsvc /vendor/bin/backlight_bin
    class main
    user root
    disabled
    oneshot
    group root system
    seclabel u:r:sardiag:s0
